filters:
  and:
    - kind == "podcast-episode"
formulas:
  connection_count: file.backlinks.length
  topic_list: list(topics).join(", ")
  has_papers: list(note["papers-discussed"]).length > 0
properties:
  formula.connection_count:
    displayName: Connections
  formula.topic_list:
    displayName: Topics
  formula.has_papers:
    displayName: Has papers
views:
  - type: table
    name: All episodes
    order:
      - file.name
      - podcast
      - published
      - formula.topic_list
      - formula.connection_count
      - status
    sort:
      - property: published
        direction: DESC
    limit: 100
  - type: table
    name: By podcast
    order:
      - file.name
      - podcast
      - published
      - formula.topic_list
    sort:
      - property: podcast
        direction: ASC
      - property: published
        direction: DESC
    limit: 100
  - type: table
    name: Unprocessed
    filters: status != "processed"
    order:
      - file.name
      - podcast
      - published
      - status
    sort:
      - property: published
        direction: DESC
  - type: table
    name: With papers
    filters: formula.has_papers
    order:
      - file.name
      - podcast
      - published
      - formula.topic_list
      - formula.connection_count
    sort:
      - property: formula.connection_count
        direction: DESC
  - type: table
    name: Connected
    filters: file.hasLink(this.file)
    order:
      - file.name
      - podcast
      - formula.topic_list
      - published
