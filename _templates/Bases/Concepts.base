filters:
  and:
    - categories.contains(link("Concepts"))
    - '!file.name.contains("Template")'
formulas:
  Links: file.links.length
  Backlinks: file.backlinks.length
views:
  - type: table
    name: All
    order:
      - file.name
      - type
      - tags
      - confidence
      - created
    sort:
      - property: created
        direction: DESC
    limit: 50
  - type: table
    name: Permanent
    filters: type == "permanent"
    order:
      - file.name
      - tags
      - confidence
      - formula.Backlinks
    sort:
      - property: formula.Backlinks
        direction: DESC
  - type: table
    name: Claims
    filters: type == "claim"
    order:
      - file.name
      - confidence
      - status
    sort:
      - property: confidence
        direction: ASC
  - type: table
    name: Ideas
    filters: 'type == "idea" || type == "fleeting"'
    order:
      - file.name
      - tags
      - created
    sort:
      - property: created
        direction: DESC
  - type: table
    name: Connected
    filters: file.hasLink(this.file)
    order:
      - file.name
      - type
      - tags
