filters:
  and:
    - categories.contains(link("Papers"))
    - '!file.name.contains("Template")'
views:
  - type: table
    name: All papers
    order:
      - file.name
      - author
      - published
      - tags
      - rating
    sort:
      - property: published
        direction: DESC
    limit: 50
  - type: table
    name: Top rated
    filters: rating > 0
    order:
      - file.name
      - rating
      - author
    sort:
      - property: rating
        direction: DESC
  - type: table
    name: By author
    filters: list(author).contains(this)
    order:
      - file.name
      - published
      - rating
