filters:
  and:
    - categories.contains(link("Trips"))
    - '!file.name.contains("Template")'
views:
  - type: table
    name: All
    order:
      - file.name
      - loc
      - start
      - end
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Top rated
    filters: rating > 0
    order:
      - file.name
      - rating
      - last
    sort:
      - property: rating
        direction: DESC
  - type: table
    name: Connected
    filters: file.hasLink(this.file)
    order:
      - file.name
      - tags
